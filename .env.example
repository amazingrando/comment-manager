NEXT_PUBLIC_APP_URL=http://localhost:3000

# From `npx supabase start` (local) or the Supabase project settings (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key as 64 hex chars. Seal Figma OAuth tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# https://www.figma.com/developers/apps
# Callback URL: http://localhost:3000/api/oauth/figma/callback
# Scopes: current_user:read, file_comments:read, file_content:read, file_metadata:read
FIGMA_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/figma/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

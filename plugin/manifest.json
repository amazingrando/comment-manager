{
  "name": "Comment Manager",
  "id": "comment-manager",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma", "figjam"],
  "documentAccess": "dynamic-page",
  "enablePrivatePluginApi": true,
  "networkAccess": {
    "allowedDomains": [
      "https://api.figma.com",
      "https://www.figma.com"
    ],
    "devAllowedDomains": [
      "http://localhost:3000"
    ],
    "reasoning": "Sign in with Figma and read comments from the open file."
  }
}
